// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// Enums
// =====================

// Removed Category enum to allow custom categories

enum AssetStatus {
  IN_USE
  AVAILABLE
  UNDER_REPAIR
  RETIRED
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DOUBLE_DECLINING
  UNITS_OF_PRODUCTION
}

enum Department {
  ADMIN_DEPARTMENT
  CORPORATE_DEPARTMENT
  CUSTOMER_CARE
  I_TECH
  I_WALLET
  IT_DEPARTMENT
  IT_SUPPORT
  JOINT_VENTURES
  MARKETING
  REAL_ESTATE
  SECRETARY
  EXECUTIVE
}

// =====================
// Models
// =====================

model Asset {
  id                 Int                @id @default(autoincrement())
  name               String
  assetTag           String             @unique
  category           String
  serialNumber       String             @unique
  purchaseDate       DateTime
  purchasePrice      Float
  salvageValue       Float
  usefulLifeYears    Int
  depreciationMethod DepreciationMethod
  totalUnits         Int?
  unitsUsed          Int?
  assignedEmployee   String?
  department         Department?
  status             AssetStatus        @default(AVAILABLE)
  location           String?
  warrantyExpiry     DateTime?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  auditLogs AuditLog[]

  @@index([status])
  @@index([category])
  @@index([assignedEmployee])
  @@index([department])
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  assetId      Int
  action       String
  employeeName String?
  details      String?
  performedBy  String   @default("System")
  timestamp    DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}
