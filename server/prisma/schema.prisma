// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// Enums
// =====================

enum AssetStatus {
  IN_USE
  AVAILABLE
  UNDER_REPAIR
  RETIRED
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DOUBLE_DECLINING
  UNITS_OF_PRODUCTION
}

enum Department {
  ADMIN_DEPARTMENT
  CORPORATE_DEPARTMENT
  CUSTOMER_CARE
  I_TECH
  I_WALLET
  IT_DEPARTMENT
  IT_SUPPORT
  JOINT_VENTURES
  MARKETING
  REAL_ESTATE
  SECRETARY
  EXECUTIVE
}

enum UserRole {
  ADMIN
  MANAGER
  VIEWER
}

enum NotificationType {
  DEPRECIATION_WARNING
  WARRANTY_EXPIRING
  AUDIT_COMPLETE
  SYSTEM_UPDATE
  ASSIGNMENT
  IMPORT
}

// =====================
// Models
// =====================

model User {
  id           Int         @id @default(autoincrement())
  email        String      @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole    @default(VIEWER)
  department   Department? @default(IT_DEPARTMENT)
  preferences  Json        @default("{}")
  lastPasswordChanged DateTime @default(now())
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  activityLogs ActivityLog[]

  @@index([email])
}

model Asset {
  id                 Int                @id @default(autoincrement())
  name               String
  assetTag           String             @unique
  category           String
  serialNumber       String             @unique
  purchaseDate       DateTime
  purchasePrice      Float
  salvageValue       Float
  usefulLifeYears    Int
  depreciationMethod DepreciationMethod
  totalUnits         Int?
  unitsUsed          Int?
  assignedEmployee   String?
  department         Department?
  status             AssetStatus        @default(AVAILABLE)
  location           String?
  warrantyExpiry     DateTime?
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([status])
  @@index([category])
  @@index([assignedEmployee])
  @@index([department])
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  assetId      Int
  action       String
  employeeName String?
  details      String?
  performedBy  String   @default("System")
  timestamp    DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
}

model Notification {
  id             Int              @id @default(autoincrement())
  type           NotificationType
  title          String
  description    String
  isRead         Boolean          @default(false)
  relatedAssetId Int?
  createdAt      DateTime         @default(now())

  relatedAsset Asset? @relation(fields: [relatedAssetId], references: [id], onDelete: SetNull)

  @@index([isRead])
  @@index([createdAt])
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  action      String
  entity      String
  entityId    Int?
  details     String?
  ipAddress   String?
  timestamp   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
  @@index([entity])
}
