# ===========================================
# IT Inventory Monitoring System
# Environment Variables
# ===========================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ===========================================

# --- Database ---
DATABASE_URL=              # PostgreSQL connection string
                           # Dev default: postgresql://inventory_user:inventory_pass@localhost:5432/it_inventory
POSTGRES_USER=             # PostgreSQL username (used by Docker)
POSTGRES_PASSWORD=         # PostgreSQL password (used by Docker)
POSTGRES_DB=               # PostgreSQL database name (used by Docker)

# --- Server ---
PORT=3001                  # Express server port (default: 3001)
NODE_ENV=development       # development | staging | production

# --- Security ---
JWT_SECRET=                # Secret key for auth tokens (min 32 chars) — future feature

# --- CORS ---
FRONTEND_URL=http://localhost:5173  # React app URL for CORS whitelist
